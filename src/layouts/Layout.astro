---
// src/layouts/Layout.astro
import { ui, defaultLang } from '../i18n/ui';

interface Props {
  title: string;
  lang?: 'es' | 'en';
}

const { title, lang = defaultLang } = Astro.props;
const t = ui[lang];
const alternateLang = lang === 'es' ? 'en' : 'es';
const alternateUrl = alternateLang === 'es' ? '/' : '/en/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header class="navbar">
      <div class="container nav-content">
        <a href={lang === 'es' ? '/' : '/en/'} class="logo">~/portafolio</a>
        <nav>
          <a href="#proyectos">{t['nav.projects']}</a>
          <a href="#sobre-mi">{t['nav.about']}</a>
          <a href="#contacto">{t['nav.contact']}</a>
          <a href={alternateUrl} class="lang-switch" title="Cambiar idioma / Switch language">
            {alternateLang.toUpperCase()}
          </a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container footer">
      <p>Construido con Astro & Markdown • {new Date().getFullYear()}</p>
    </footer>

    <style is:global>
      :root {
        --bg-primary: #0d1117;
        --bg-secondary: #161b22;
        --border-color: #30363d;
        --text-primary: #e6edf3;
        --text-secondary: #8b949e;
        --accent: #58a6ff;
        --accent-hover: #79c0ff;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, monospace;
        line-height: 1.6;
      }

      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .navbar {
        border-bottom: 1px solid var(--border-color);
        padding: 1rem 0;
        position: sticky;
        top: 0;
        background-color: rgba(13, 17, 23, 0.9);
        backdrop-filter: blur(8px);
      }

      .nav-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        color: var(--accent);
        text-decoration: none;
        font-weight: bold;
        font-family: monospace;
        font-size: 1.1rem;
      }

      nav {
        display: flex;
        gap: 1.25rem;
        align-items: center;
      }

      nav a {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 0.2s;
      }

      nav a:hover {
        color: var(--text-primary);
      }

      .lang-switch {
        border: 1px solid var(--border-color);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        font-family: monospace;
        font-size: 0.85rem;
        color: var(--text-primary);
      }

      .lang-switch:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      .footer {
        margin-top: 4rem;
        padding: 2rem 1.5rem;
        border-top: 1px solid var(--border-color);
        text-align: center;
        color: var(--text-secondary);
        font-size: 0.85rem;
      }
    </style>
  </body>
</html>
