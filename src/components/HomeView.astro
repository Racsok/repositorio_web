---
// src/components/HomeView.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = ui[lang];

const allProjects = await getCollection('projects', ({ data }) => data.lang === lang);
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<Layout title={`Portafolio | ${t['hero.title']}`} lang={lang}>
  <section class="hero">
    <h1>Oscar Contreras</h1>
    <h2>{t['hero.title']}</h2>
    <p>{t['hero.subtitle']}</p>
    <div class="hero-actions">
      <a href="/cv.pdf" target="_blank" class="btn primary">{t['cv.download']}</a>
      <a href="https://github.com/tu-usuario" target="_blank" class="btn secondary">GitHub</a>
    </div>
  </section>

  <section id="proyectos" class="section">
    <h3>{t['nav.projects']}</h3>
    <div class="projects-grid">
      {projects.map((project) => (
        <article class="card">
          <h4>{project.data.title}</h4>
          <p>{project.data.description}</p>
          <div class="tags">
            {project.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          {project.data.repoUrl && (
            <a href={project.data.repoUrl} target="_blank" class="repo-link">
              {lang === 'es' ? 'Ver código →' : 'View code →'}
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <section id="sobre-mi" class="section">
    <h3>{t['nav.about']}</h3>
    <p class="about-text">
      {lang === 'es'
        ? 'Estudiante de último semestre de Ingeniería de Sistemas enfocado en Ingeniería de Datos, desarrollo Backend y automatización en entornos Linux.'
        : 'Final-semester Systems Engineering student focused on Data Engineering, Backend development, and automation in Linux environments.'}
    </p>
  </section>
</Layout>

<style>
  .hero {
    padding: 4.5rem 0 3rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.25rem;
  }

  .hero h2 {
    font-size: 1.4rem;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .hero p {
    color: var(--text-secondary);
    max-width: 600px;
    margin-bottom: 1.75rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  .btn {
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s;
  }

  .btn.primary {
    background-color: var(--accent);
    color: #0d1117;
  }

  .btn.primary:hover {
    background-color: var(--accent-hover);
  }

  .btn.secondary {
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  .btn.secondary:hover {
    border-color: var(--text-secondary);
  }

  .section {
    padding: 2.5rem 0;
  }

  .section h3 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card h4 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .tag {
    background-color: rgba(88, 166, 255, 0.1);
    color: var(--accent);
    font-family: monospace;
    font-size: 0.78rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .repo-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .repo-link:hover {
    text-decoration: underline;
  }

  .about-text {
    color: var(--text-secondary);
    max-width: 700px;
  }
</style>
